{
  "name": "migrabench",
  "version": "0.0.0",
  "private": true,
  "description": "Banc de mesure pour migrations de front legacy assistées par agent.",
  "type": "module",
  "engines": {
    "node": "22.23.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "stack:up": "node scripts/stack-up.ts",
    "pretest": "node scripts/check-node-version.mjs",
    "test": "vitest run",
    "preoracle": "node scripts/check-node-version.mjs",
    "oracle": "node oracle/cli.ts",
    "premigrabench": "node scripts/check-node-version.mjs",
    "migrabench": "node runner/cli.ts",
    "oracle:proof": "node scripts/check-oracle-proof.ts",
    "fetch:pull-heads": "git fetch --no-tags origin '+refs/pull/*/head:refs/remotes/origin/pull/*'"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
