<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         version="2.5">

  <display-name>migrabench legacy</display-name>

  <!-- Charge le jeu de données en mémoire au démarrage. -->
  <listener>
    <listener-class>fr.migrabench.legacy.web.DossierServiceListener</listener-class>
  </listener>

  <!-- L'écran 2 envoie sa saisie en POST : Tomcat lirait le corps en
       ISO-8859-1 sans ce filtre, fourni par Tomcat. -->
  <filter>
    <filter-name>utf8</filter-name>
    <filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
    <init-param>
      <param-name>encoding</param-name>
      <param-value>UTF-8</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>utf8</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Filtre par port : pièce du banc, ni piège ni comportement à migrer
       (ADR 0004). Refuse l'API interne si la requête n'arrive pas par 8081. -->
  <filter>
    <filter-name>internalApiPort</filter-name>
    <filter-class>fr.migrabench.legacy.api.InternalApiPortFilter</filter-class>
    <init-param>
      <param-name>port</param-name>
      <param-value>8081</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>internalApiPort</filter-name>
    <url-pattern>/api/*</url-pattern>
  </filter-mapping>

  <!-- API interne JSON (rechercher, lire, modifier, remettre). -->
  <servlet>
    <servlet-name>internalApi</servlet-name>
    <servlet-class>fr.migrabench.legacy.api.InternalApiServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>internalApi</servlet-name>
    <url-pattern>/api/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>action</servlet-name>
    <servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
    <init-param>
      <param-name>config</param-name>
      <param-value>/WEB-INF/struts-config.xml</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>

  <servlet-mapping>
    <servlet-name>action</servlet-name>
    <url-pattern>*.do</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- Authentification Tomcat en BASIC, sans écran de connexion (ADR 0003).
       Les utilisateurs viennent de conf/tomcat-users.xml, généré depuis
       fixtures/users.json. -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>legacy</web-resource-name>
      <url-pattern>/*</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>agent</role-name>
      <role-name>instructeur</role-name>
    </auth-constraint>
  </security-constraint>

  <!-- L'API interne ignore l'identité de l'appelant (ADR 0003) : pas
       d'authentification sur /api/*, motif plus précis que /*. Son isolation
       tient au filtre par port et au réseau mb-internal (ADR 0004). -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>internal API</web-resource-name>
      <url-pattern>/api/*</url-pattern>
    </web-resource-collection>
  </security-constraint>

  <login-config>
    <auth-method>BASIC</auth-method>
    <realm-name>migrabench</realm-name>
  </login-config>

  <security-role>
    <role-name>agent</role-name>
  </security-role>
  <security-role>
    <role-name>instructeur</role-name>
  </security-role>
</web-app>
