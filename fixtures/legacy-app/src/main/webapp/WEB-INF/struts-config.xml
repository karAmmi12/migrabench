<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC
  "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
  "http://struts.apache.org/dtds/struts-config_1_3.dtd">
<struts-config>
  <form-beans>
    <form-bean name="searchForm" type="fr.migrabench.legacy.web.SearchForm"/>
    <form-bean name="dossierForm" type="fr.migrabench.legacy.web.DossierForm"/>
  </form-beans>

  <action-mappings>
    <!-- Écran 1 : formulaire seul à l'ouverture. -->
    <action path="/recherche" forward="/WEB-INF/jsp/recherche.jsp"/>
    <!-- Écran 1 : formulaire soumis, avec résultats. Une saisie refusée par
         validation.xml revient sur la JSP (input) avec les valeurs saisies. -->
    <action path="/rechercher"
            type="fr.migrabench.legacy.web.SearchAction"
            name="searchForm"
            scope="request"
            validate="true"
            input="/WEB-INF/jsp/recherche.jsp">
      <forward name="success" path="/WEB-INF/jsp/recherche.jsp"/>
    </action>

    <!-- Écran 2 : fiche du dossier ?number=, formulaire rempli avec le dossier. -->
    <action path="/fiche"
            type="fr.migrabench.legacy.web.ShowDossierAction"
            name="dossierForm"
            scope="request"
            validate="false">
      <forward name="success" path="/WEB-INF/jsp/fiche.jsp"/>
    </action>
    <!-- Écran 2 : retour d'une saisie refusée par validation.xml. La fiche
         garde les valeurs saisies ; seul le statut est relu. -->
    <action path="/ficheSaisie"
            type="fr.migrabench.legacy.web.ShowDossierAction"
            name="dossierForm"
            scope="request"
            validate="false"
            parameter="keepInput">
      <forward name="success" path="/WEB-INF/jsp/fiche.jsp"/>
    </action>
    <!-- Écran 2 : enregistrement (bouton ou Ctrl+S). Une saisie refusée par
         validation.xml revient sur /ficheSaisie.do (input). -->
    <action path="/enregistrer"
            type="fr.migrabench.legacy.web.SaveDossierAction"
            name="dossierForm"
            scope="request"
            validate="true"
            input="/ficheSaisie.do">
      <forward name="saved" path="/fiche.do" redirect="true"/>
    </action>
  </action-mappings>

  <message-resources parameter="fr.migrabench.legacy.ApplicationResources"/>

  <!-- Règles de saisie déclarées seulement dans validation.xml (TRAPS.md). -->
  <plug-in className="org.apache.struts.validator.ValidatorPlugIn">
    <set-property property="pathnames"
                  value="/org/apache/struts/validator/validator-rules.xml,/WEB-INF/validation.xml"/>
  </plug-in>
</struts-config>
