# Journal d'accès du banc (#67) : aucune réécriture, seulement deux attributs
# de requête lus par la valve d'accès (access-log-valve.xml). SERVER_PORT est
# le port du connecteur qui a reçu la requête, pas celui de l'en-tête Host.
RewriteRule .* - [E=mbLocalPort:%{SERVER_PORT}]
RewriteCond %{SERVER_PORT} =8081
RewriteRule .* - [E=mbInternalApi:1]
